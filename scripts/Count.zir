#[include "std/io", "std/file", "std/str", "std/map" : *]

class Stats {
    pub hardware_counts: Map<String, usize>,
    pub software_counts: Map<String, usize>,
    pub toolchain_counts: Map<String, usize>,
    pub other_counts: Map<String, usize>
}

fn GetLineCount(path: &String) -> usize {
    let content = File::ReadText(path).Unwrap();
    if content.Empty() { return 0; }
    let lines = content.Count('\n');

    if content[content.Length() - 1] != '\n' {
        return lines + 1;
    }

    lines
}

fn ProcessDirectory(directory: &String, stats: &mut Stats) {
    let entries = match ListFolder(directory) {
        Result<Vector<FolderEntry>, IOError>::Ok(entries) => entries,
        Result<Vector<FolderEntry>, IOError>::Err(_) => {
            return;
        }
    };

    for entry in entries {
        let path = JoinPath(directory, entry.name);

        if entry.kind == EntryKind::Folder {
            ProcessDirectory(path, stats);
        } else if SplitExtension(entry.name).1 == ".zir" {
            let lines = GetLineCount(path);

            if path.Contains("src") {
                let toolchain = SplitPath(path).0;

                if stats.toolchain_counts.Has(toolchain) {
                    stats.toolchain_counts[toolchain] += lines;
                } else {
                    stats.toolchain_counts[toolchain] = lines;
                }
            } else if entry.name == "program.zir" {
                stats.software_counts[path] = lines;
            } else {
                stats.other_counts[path] = lines;
            }
        } else if SplitExtension(entry.name).1 == ".sv" {
            stats.hardware_counts[path] = GetLineCount(path);
        } else if SplitExtension(entry.name).1 == ".s" {
            if entry.name != "program.s" {
                stats.software_counts[path] = GetLineCount(path);
            }
        }
    }
}

fn PrintMap(title: *i8, map: Map<String, usize>) -> usize {
    let mut total: usize = 0;
    WriteLine("--- " + title.ToString() + " ---");

    for (name, lines) in map {
        WriteLine(name + ": " + String::FromInteger(lines as i64) + " lines");
        total += lines;
    }

    WriteLine("Subtotal: " + String::FromInteger(total as i64) + " lines\n");
    total
}

fn Main(args: &mut Vector<String>) -> i32 {
    let mut stats: Stats;
    ProcessDirectory(".".ToString(), &mut stats);
    let hardware_total = PrintMap("Hardware", stats.hardware_counts);
    let software_total = PrintMap("Software", stats.software_counts);
    let toolchain_total = PrintMap("Toolchain", stats.toolchain_counts);
    let other_total = PrintMap("Other", stats.other_counts);
    let total = hardware_total + software_total + toolchain_total + other_total;
    WriteLine("==========================================");
    WriteLine("TOTAL LINES:  " + String::FromInteger(total as i64) + " lines");
    WriteLine("==========================================");
    0
}
