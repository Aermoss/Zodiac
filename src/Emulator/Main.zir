#[include "std/io", "std/str", "std/vec", "src/Emulator/Emulator.zir", "src/Common/Logger.zir" : *]

fn PrintVersion(executable: String) {
    WriteLine("Unversioned build of " + executable + ".");
    WriteLine("Copyright (c) 2026 Yusuf Rençber.");
    WriteLine("Licensed under the Apache License, Version 2.0.");
    WriteLine("See the LICENSE file for details.");
}

fn PrintUsage(executable: String) {
    WriteLine("OVERVIEW: Zodiac emulator");
    WriteLine("USAGE: " + executable + " [options] <input>");
    WriteLine("OPTIONS:");
    WriteLine("  --flash=<file>[@<offset>] Load <file> into flash at <offset>, 0x100000 if not given");
    WriteLine("  --quiet                  Do not report writes to the LEDs, WS2812 and baud rate");
    WriteLine("  --version                Display emulator version");
    WriteLine("  -h, --help               Display this help message");
}

fn Main(args: &mut Vector<String>) -> i32 {
    let (_, executable) = SplitPath(args[0]);
    let mut logger = Logger(executable);

    if args.Length() < 2 {
        PrintUsage(executable);
        return 1;
    }

    let mut quiet = false;
    let mut input = String();
    let mut flash_files = Vector<String>();
    let mut flash_offsets = Vector<u32>();
    let mut i: usize = 1;

    while i < args.Length() {
        let arg = args[i];

        if arg == "--help" || arg == "-h" {
            PrintUsage(executable);
            return 0;
        } else if arg == "--version" {
            PrintVersion(executable);
            return 0;
        } else if arg == "--quiet" {
            quiet = true;
        } else if arg.StartsWith("--flash=") {
            let parts = arg.SubString(8).Split('@');
            let mut offset: u32 = 0x100000;

            if parts.Length() > 1 {
                let text = parts[1];

                if text.StartsWith("0x") {
                    offset = String::ToInteger(text.SubString(2), 16).Unwrap() as u32;
                } else {
                    offset = String::ToInteger(text, 10).Unwrap() as u32;
                }
            }

            if !FileExists(parts[0]) {
                Logger::Log("Cannot find '" + parts[0] + "'.", LogSeverity::Error);
                return 1;
            }

            flash_files.PushBack(parts[0]);
            flash_offsets.PushBack(offset);
        } else if FileExists(arg) {
            input = arg;
        } else {
            Logger::Log("Cannot find '" + arg + "'.", LogSeverity::Error);
            return 1;
        } i += 1;
    }

    if input.Empty() {
        Logger::Log("No input file.", LogSeverity::Error);
        return 1;
    }

    let mut emulator = Emulator(quiet);

    if !emulator.Load(input, 0) {
        Logger::Log("Failed to load program '" + input + "'.", LogSeverity::Error);
        return 1;
    }

    for j in 0..flash_files.Length() {
        if !emulator.Load(flash_files[j], 0x80000000 + flash_offsets[j]) {
            Logger::Log("Failed to load flash image '" + flash_files[j] + "'.", LogSeverity::Error);
            return 1;
        }
    }

    emulator.Emulate();
    0
}
