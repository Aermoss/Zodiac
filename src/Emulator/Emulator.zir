#[include "std/io", "std/str", "std/vec", "std/file", "std/thrd",
    "src/Common/File.zir", "src/Common/Endian.zir", "src/Common/Instruction.zir" : *]

extern "C" {
    fn _getch() -> i32;
}

const CLK_FREQ: u32 = 54000000;
const CYCLES_PER_MS: u32 = CLK_FREQ / 1000;

const SDRAM_START: u32 = 0x40000000;
const SDRAM_MASK: u32 = 0x007FFFFF;
const TLB_ENTRIES: u32 = 64;

enum Access: u32 {
    Fetch, Load, Store
}

class Emulator {
    pub quiet: bool,
    pc: u32,
    halted: bool,
    user_mode: bool,
    previous_user: bool,
    registers: *mut u32,
    bram: *mut u8,
    sdram: *mut u8,
    flash: *mut u8,
    cycle_counter: u64,
    instruction_counter: u32,
    uart_rx: u8,
    uart_rx_ready: bool,
    uart_mutex: Mutex,
    uart_changed: ConditionVariable,
    interrupt_enable: bool,
    previous_interrupt_enable: bool,
    interrupt_mask: u32,
    trap_pc: u32,
    trap_cause: u32,
    trap_vector: u32,
    trap_scratch: u32,
    trap_address: u32,
    kernel_stack: u32,
    page_table_base: u32,
    address_space: u32,
    tlb_keys: *mut u32,
    tlb_entries: *mut u32,
    timer_compare: u32,
    flash_selected: bool,
    flash_write_enabled: bool,
    flash_read_warned: bool,
    flash_command: u8,
    flash_rx: u8,
    flash_count: u32,
    flash_address: u32,
    flash_paths: Vector<String>,
    flash_offsets: Vector<u32>,
    flash_sizes: Vector<u32>;

    Emulator(&mut this, quiet: bool) {
        this.quiet = quiet;
        this.registers = new u32[32];
        this.tlb_keys = new u32[TLB_ENTRIES as usize];
        this.tlb_entries = new u32[TLB_ENTRIES as usize];
        this.bram = new u8[16 * 1024];
        this.sdram = new u8[8 * 1024 * 1024];
        this.flash = new u8[8 * 1024 * 1024];

        for i in 0..(8 * 1024 * 1024) {
            this.flash[i as usize] = 0xFF;
        }

        this.Reset();
    }

    ~Emulator(&mut this) {
        delete[] this.flash;
        delete[] this.sdram;
        delete[] this.bram;
        delete[] this.tlb_entries;
        delete[] this.tlb_keys;
        delete[] this.registers;
    }

    pub fn Load(&mut this, path: &String, address: u32) -> bool {
        let (_, extension) = SplitExtension(path);

        if extension == ".hex" {
            this.LoadHexadecimal(path, address)
        } else if extension == ".bin" {
            this.LoadBinary(path, address)
        } else {
            false
        }
    }

    pub fn LoadHexadecimal(&mut this, path: &String, address: u32) -> bool {
        let content = File::ReadText(path).Unwrap();
        if content.Empty() { return false; }
        let mut offset: u32 = 0;

        for line in content.Split('\n') {
            if line.Empty() { continue; }
            let word = line.Strip().ToInteger(16).Unwrap() as u32;
            this.WriteWord(address + offset, word);
            offset += 4;
        }

        true
    }

    pub fn LoadBinary(&mut this, path: &String, address: u32) -> bool {
        let mut file = _File(path);
        if !file.Open(FileMode::Read) { return false; }
        let mut offset: u32 = 0;

        loop {
            let mut word: u32 = 0;
            if !file.ReadWords(&mut word, 1) { break; }
            this.WriteWord(address + offset, ByteSwap32(word));
            offset += 4;
        }

        if (address & 0xC0000000) == 0x80000000 {
            this.flash_paths.PushBack(path);
            this.flash_offsets.PushBack(address & 0x7FFFFF);
            this.flash_sizes.PushBack(offset);
        }

        true
    }

    pub fn Reset(&mut this) {
        (this.pc, this.halted, this.user_mode, this.previous_user) = (0, false, false, false);
        (this.cycle_counter, this.instruction_counter) = (0, 0);
        (this.interrupt_enable, this.previous_interrupt_enable, this.interrupt_mask) = (false, false, 0);
        (this.trap_pc, this.trap_cause, this.trap_vector, this.trap_scratch, this.trap_address) = (0, 0, 0, 0, 0);
        (this.kernel_stack, this.page_table_base, this.address_space) = (0, 0, 0);
        this.FlushTLB();
        this.timer_compare = 0;
        (this.flash_selected, this.flash_write_enabled, this.flash_read_warned) = (false, false, false);
        (this.flash_command, this.flash_rx, this.flash_count, this.flash_address) = (0, 0, 0, 0);

        for i in 0..32 {
            this.registers[i as usize] = 0;
        }
    }

    fn GetRegister(&this, index: u32) -> u32 {
        this.registers[index as usize]
    }

    fn SetRegister(&mut this, index: u32, value: u32) {
        if index != 0 {
            this.registers[index as usize] = value;
        }
    }

    fn IsDevice(&this, address: u32) -> bool {
        address == 0xFFFF || address == 0xFFFC || address == 0xFFF4 || address == 0xFFEC || address == 0xFFE8 || address == 0xFFE4 || address == 0xFFDC || address == 0xFFD8 || address == 0xFFD4
    }

    fn SelectFlash(&mut this, selected: bool) {
        if selected && !this.flash_selected {
            (this.flash_command, this.flash_count, this.flash_address) = (0, 0, 0);
        } else if !selected && this.flash_selected {
            this.FinishFlashCommand();
        }

        this.flash_selected = selected;
    }

    fn FinishFlashCommand(&mut this) {
        let command = this.flash_command;

        if command == 0x06 && this.flash_count == 1 {
            this.flash_write_enabled = true;
        } else if command == 0x04 {
            this.flash_write_enabled = false;
        } else if command == 0x20 && this.flash_count == 4 && this.flash_write_enabled {
            let sector = this.flash_address & 0x7FF000;
            let mut i: u32 = 0;

            while i < 4096 {
                this.flash[(sector + i) as usize] = 0xFF;
                i += 1;
            }

            this.flash_write_enabled = false;
            this.SaveFlash(sector, 4096);
        } else if command == 0x02 && this.flash_count > 4 && this.flash_write_enabled {
            this.flash_write_enabled = false;
            this.SaveFlash(this.flash_address & 0x7FFF00, 256);
        }
    }

    fn TransferFlashByte(&mut this, value: u8) {
        if !this.flash_selected {
            return;
        }

        let (command, count) = (this.flash_command, this.flash_count);
        let mut result: u8 = 0xFF;

        if count == 0 {
            this.flash_command = value;
        } else if count < 4 && (command == 0x03 || command == 0x20 || command == 0x02) {
            this.flash_address = ((this.flash_address << 8) | value as u32) & 0xFFFFFF;
        } else if command == 0x03 {
            result = this.flash[(((this.flash_address + count - 4) & 0x7FFFFF) ^ 3) as usize];
        } else if command == 0x02 {
            if this.flash_write_enabled {
                let address = (this.flash_address & 0x7FFF00) | ((this.flash_address + count - 4) & 0xFF);
                this.flash[(address ^ 3) as usize] = this.flash[(address ^ 3) as usize] & value;
            }
        } else if command == 0x05 {
            result = if this.flash_write_enabled { 2 } else { 0 };
        } else if command == 0x9F {
            result = if count == 1 { 0xEF } else if count == 2 { 0x40 } else { 0x17 };
        }

        this.flash_rx = result;
        this.flash_count = count + 1;
    }

    fn SaveFlash(&mut this, start: u32, length: u32) {
        for i in 0..this.flash_paths.Length() {
            let offset = this.flash_offsets[i];

            if start < offset || start + length > offset + this.flash_sizes[i] {
                continue;
            }

            let mut file = _File(this.flash_paths[i]);

            if !file.Open(FileMode::Update) || !file.Seek(start - offset) {
                continue;
            }

            let mut address = start;

            while address < start + length {
                let mut word = this.flash[address as usize] as u32;
                word |= this.flash[(address + 1) as usize] as u32 << 8;
                word |= this.flash[(address + 2) as usize] as u32 << 16;
                word |= this.flash[(address + 3) as usize] as u32 << 24;
                file.WriteWord(ByteSwap32(word));
                address += 4;
            }
        }
    }

    fn IsUartReady(&mut this) -> bool {
        this.uart_mutex.Lock();
        let ready = this.uart_rx_ready;
        this.uart_mutex.Unlock();
        ready
    }

    fn GetPendingInterrupts(&mut this, mask: u32) -> u32 {
        let uart: u32 = if (mask & 2) != 0 && this.IsUartReady() { 2 } else { 0 };
        let timer: u32 = if (mask & 1) != 0 && ((this.cycle_counter as u32 - this.timer_compare) as i32) >= 0 { 1 } else { 0 };
        uart | timer
    }

    fn ReadCSR(&mut this, index: u32) -> u32 {
        if index == CSR::STATUS as u32 {
            let mut status: u32 = 0;
            if this.interrupt_enable { status |= STATUS_IE; }
            if this.previous_interrupt_enable { status |= STATUS_PIE; }
            if this.previous_user { status |= STATUS_PU; }
            status
        } else if index == CSR::IENABLE as u32 {
            this.interrupt_mask
        } else if index == CSR::IPENDING as u32 {
            this.GetPendingInterrupts(3)
        } else if index == CSR::EPC as u32 {
            this.trap_pc
        } else if index == CSR::CAUSE as u32 {
            this.trap_cause
        } else if index == CSR::VECTOR as u32 {
            this.trap_vector
        } else if index == CSR::SCRATCH as u32 {
            this.trap_scratch
        } else if index == CSR::BADADDR as u32 {
            this.trap_address
        } else if index == CSR::KSTACK as u32 {
            this.kernel_stack
        } else if index == CSR::PTBASE as u32 {
            this.page_table_base
        } else if index == CSR::ASID as u32 {
            this.address_space
        } else if index == CSR::CYCLE as u32 {
            this.cycle_counter as u32
        } else if index == CSR::INSTRET as u32 {
            this.instruction_counter
        } else if index == CSR::TIME as u32 {
            (this.cycle_counter / CYCLES_PER_MS as u64) as u32
        } else {
            0
        }
    }

    fn WriteCSR(&mut this, index: u32, value: u32) {
        if index == CSR::STATUS as u32 {
            this.interrupt_enable = (value & STATUS_IE) != 0;
            this.previous_interrupt_enable = (value & STATUS_PIE) != 0;
            this.previous_user = (value & STATUS_PU) != 0;
        } else if index == CSR::IENABLE as u32 {
            this.interrupt_mask = value;
        } else if index == CSR::EPC as u32 {
            this.trap_pc = value;
        } else if index == CSR::CAUSE as u32 {
            this.trap_cause = value;
        } else if index == CSR::VECTOR as u32 {
            this.trap_vector = value;
        } else if index == CSR::SCRATCH as u32 {
            this.trap_scratch = value;
        } else if index == CSR::BADADDR as u32 {
            this.trap_address = value;
        } else if index == CSR::KSTACK as u32 {
            this.kernel_stack = value;
        } else if index == CSR::PTBASE as u32 {
            this.page_table_base = value;
        } else if index == CSR::ASID as u32 {
            this.address_space = value;
        } else if index == CSR::TLBFLUSH as u32 {
            this.FlushTLB();
        }
    }

    fn FlushTLB(&mut this) {
        for i in 0..TLB_ENTRIES {
            this.tlb_keys[i as usize] = 0;
        }
    }

    fn ReadTableEntry(&this, address: u32) -> u32 {
        let offset = (address & SDRAM_MASK & !3u32) as usize;
        let mut entry = this.sdram[offset] as u32;
        entry |= this.sdram[offset + 1] as u32 << 8;
        entry |= this.sdram[offset + 2] as u32 << 16;
        entry |= this.sdram[offset + 3] as u32 << 24;
        entry
    }

    fn Translate(&mut this, address: u32, access: Access, physical: *mut u32) -> bool {
        if address < WINDOW_START {
            *physical = address;
            return !this.user_mode;
        }

        let page = (address - WINDOW_START) >> PAGE_SHIFT;
        let key = 0x80000000 | ((this.address_space & 0xF) << 18) | page;
        let slot = (page & (TLB_ENTRIES - 1)) as usize;
        let mut entry: u32 = 0;

        if this.tlb_keys[slot] == key {
            entry = this.tlb_entries[slot];
        } else {
            if (this.page_table_base & PTBASE_VALID) == 0 {
                return false;
            }

            let root = SDRAM_START | (this.page_table_base & 0x007FFC00);
            let directory = this.ReadTableEntry(root + (page >> 10) * 4);

            if (directory & PTE_VALID) == 0 {
                return false;
            }

            let table = SDRAM_START | (directory & 0x007FF000);
            entry = this.ReadTableEntry(table + (page & 0x3FF) * 4);

            if (entry & PTE_VALID) == 0 {
                return false;
            }

            this.tlb_keys[slot] = key;
            this.tlb_entries[slot] = entry;
        }

        if access == Access::Store && (entry & PTE_WRITE) == 0 {
            return false;
        }

        if access == Access::Fetch && (entry & PTE_EXECUTE) == 0 {
            return false;
        }

        *physical = SDRAM_START | (entry & 0x007FF000) | (address & (PAGE_SIZE - 1));
        true
    }

    fn Trap(&mut this, cause: u32, epc: u32, address: u32) {
        (this.trap_pc, this.trap_cause, this.trap_address) = (epc, cause, address);
        (this.previous_interrupt_enable, this.interrupt_enable) = (this.interrupt_enable, false);
        (this.previous_user, this.user_mode) = (this.user_mode, false);
        this.pc = this.trap_vector;
    }

    fn IsAllowed(&this, opcode: Opcode, csr: u32) -> bool {
        if !this.user_mode {
            return true;
        }

        match opcode {
            Opcode::CSRW | Opcode::ERET | Opcode::WFI | Opcode::HLT => false,
            Opcode::CSRR => csr >= FIRST_USER_CSR && csr <= LAST_USER_CSR,
            _ => true
        }
    }

    fn ReadDevice(&mut this, address: u32) -> u32 {
        match address {
            0xFFFF => {
                this.uart_mutex.Lock();
                let mut result: u32 = 0;
                if this.uart_rx_ready {
                    result = this.uart_rx as u32;
                    this.uart_rx_ready = false;
                    this.uart_changed.Signal();
                }
                this.uart_mutex.Unlock();
                result * 0x01010101
            },
            0xFFFC => if this.IsUartReady() { 1 } else { 0 },
            0xFFF4 => 0,
            0xFFE8 => this.cycle_counter as u32,
            0xFFE4 => this.instruction_counter,
            0xFFDC => this.timer_compare,
            0xFFD8 => this.flash_rx as u32,
            0xFFD4 => if this.flash_selected { 1 } else { 0 },
            _ => (this.cycle_counter / CYCLES_PER_MS as u64) as u32
        }
    }

    fn ReadByte(&mut this, address: u32) -> u8 {
        if this.IsDevice(address) {
            ((this.ReadDevice(address) >> (8 * (address & 3))) & 0xFF) as u8
        } else if (address & 0xC0000000) == 0x80000000 {
            if this.flash_selected && !this.flash_read_warned {
                WriteLine("[Flash: read while CS is held by the software]");
                this.flash_read_warned = true;
            }

            this.flash[(address & 0x7FFFFF) as usize]
        } else if (address & 0xC0000000) == 0x40000000 {
            this.sdram[(address & 0x7FFFFF) as usize]
        } else if address < 16384 {
            this.bram[address as usize]
        } else {
            0
        }
    }

    fn ReadHalf(&mut this, address: u32) -> u16 {
        if this.IsDevice(address) {
            ((this.ReadDevice(address) >> (16 * ((address >> 1) & 1))) & 0xFFFF) as u16
        } else {
            let mut result = this.ReadByte(address) as u32;
            result |= (this.ReadByte(address + 1) as u32 << 8);
            result as u16
        }
    }

    fn ReadWord(&mut this, address: u32) -> u32 {
        if this.IsDevice(address) {
            this.ReadDevice(address)
        } else {
            let mut result = this.ReadByte(address) as u32;
            result |= (this.ReadByte(address + 1) as u32 << 8);
            result |= (this.ReadByte(address + 2) as u32 << 16);
            result |= (this.ReadByte(address + 3) as u32 << 24);
            result
        }
    }

    fn WriteByte(&mut this, address: u32, value: u8) {
        if address == 0xFFFF {
            Write((value as i8).ToString());
        } else if address == 0xFFF0 {
            if !this.quiet {
                WriteLine("[LEDs: 0x" + String::FromInteger(value as u64, 16) + ']');
            }
        } else if (address & 0xC0000000) == 0x80000000 {
            this.flash[(address & 0x7FFFFF) as usize] = value;
        } else if (address & 0xC0000000) == 0x40000000 {
            this.sdram[(address & 0x7FFFFF) as usize] = value;
        } else if address < 16384 {
            this.bram[address as usize] = value;
        }
    }

    fn WriteHalf(&mut this, address: u32, value: u16) {
        this.WriteByte(address, (value as u32 & 0xFF) as u8);
        this.WriteByte(address + 1, ((value as u32 >> 8) & 0xFF) as u8);
    }

    fn WriteWord(&mut this, address: u32, value: u32) {
        match address {
            0xFFE0 => {
                if !this.quiet {
                    WriteLine("[WS2812: RGB(0x" + String::FromInteger(value as u64, 16) + ")]");
                }
            },
            0xFFF8 => {
                if !this.quiet {
                    WriteLine("[UART Baud Rate: ~" + String::FromInteger((CLK_FREQ / value) as u64, 10) + ']');
                }
            },
            0xFFDC => {
                this.timer_compare = value;
            },
            0xFFD4 => {
                this.SelectFlash((value & 1) != 0);
            },
            0xFFD8 => {
                this.TransferFlashByte((value & 0xFF) as u8);
            },
            _ => {
                this.WriteByte(address, (value & 0xFF) as u8);
                this.WriteByte(address + 1, ((value >> 8) & 0xFF) as u8);
                this.WriteByte(address + 2, ((value >> 16) & 0xFF) as u8);
                this.WriteByte(address + 3, ((value >> 24) & 0xFF) as u8);
            }
        }
    }

    fn WaitForInterrupt(&mut this) {
        let timer_enabled = (this.interrupt_mask & 1) != 0;
        let uart_enabled = (this.interrupt_mask & 2) != 0;
        if !timer_enabled && !uart_enabled { return; }
        let cycles_until_timer = (this.timer_compare - this.cycle_counter as u32) as i32;
        let mut elapsed_cycles: u64 = 0;
        this.uart_mutex.Lock();
        let started = Instant::Now();

        while (!uart_enabled || !this.uart_rx_ready) && (!timer_enabled || (cycles_until_timer > 0 && elapsed_cycles < cycles_until_timer as u64)) {
            let timeout = if timer_enabled {
                ((cycles_until_timer as u64 - elapsed_cycles + CYCLES_PER_MS as u64 - 1) / CYCLES_PER_MS as u64) as u32
            } else { INFINITE };

            this.uart_changed.Wait(&mut this.uart_mutex, timeout);
            elapsed_cycles = (started.Elapsed() * CLK_FREQ as f64) as u64;
        }

        this.uart_mutex.Unlock();
        this.cycle_counter += elapsed_cycles;
    }

    fn Tick(&mut this) {
        this.Step();
        this.cycle_counter += 1;
    }

    fn Step(&mut this) {
        let interrupts = if this.interrupt_enable {
            this.GetPendingInterrupts(this.interrupt_mask)
        } else { 0 };

        if interrupts != 0 {
            this.Trap(if (interrupts & 1) != 0 { TrapCause::Timer as u32 } else { TrapCause::Uart as u32 }, this.pc, 0);
        }

        let mut fetch_address: u32 = 0;

        if !this.Translate(this.pc, Access::Fetch, &mut fetch_address) {
            this.Trap(TrapCause::InstructionFault as u32, this.pc, this.pc);
            return;
        }

        let word = this.ReadWord(fetch_address);
        let raw_opcode = word >> OPCODE_SHIFT;
        let opcode = raw_opcode as Opcode;
        let (reg0, reg1, reg2) = ((word >> REG0_SHIFT) & 0x1F, (word >> REG1_SHIFT) & 0x1F, (word >> REG2_SHIFT) & 0x1F);
        let (imm16, imm21, imm26) = (word & IMM16_MASK, word & IMM21_MASK, word & IMM26_MASK);
        let simm16 = (((imm16 as i32) ^ (1 << 15)) - (1 << 15));
        let simm21 = (((imm21 as i32) ^ (1 << 20)) - (1 << 20));
        let simm26 = (((imm26 as i32) ^ (1 << 25)) - (1 << 25));

        if (raw_opcode > Opcode::WFI as u32 && raw_opcode != Opcode::HLT as u32) || !this.IsAllowed(opcode, imm16) {
            this.Trap(TrapCause::IllegalInstruction as u32, this.pc, word);
            return;
        }

        let is_load = match opcode {
            Opcode::LB | Opcode::LBU | Opcode::LH | Opcode::LHU | Opcode::LW => true,
            _ => false
        };

        let is_store = match opcode {
            Opcode::SB | Opcode::SH | Opcode::SW => true,
            _ => false
        };

        let mut address: u32 = 0;

        if is_load || is_store {
            let virtual_address = (this.GetRegister(reg1) as i32 + simm16) as u32;

            if !this.Translate(virtual_address, if is_store { Access::Store } else { Access::Load }, &mut address) {
                this.Trap(if is_store { TrapCause::StoreFault as u32 } else { TrapCause::LoadFault as u32 }, this.pc, virtual_address);
                return;
            }
        }

        let mut next_pc = this.pc + 4;

        match opcode {
            Opcode::NOP => {},
            Opcode::LB => {
                this.SetRegister(reg0, this.ReadByte(address) as i8 as u32);
            },
            Opcode::LBU => {
                this.SetRegister(reg0, this.ReadByte(address) as u32);
            },
            Opcode::LH => {
                this.SetRegister(reg0, this.ReadHalf(address) as i16 as u32);
            },
            Opcode::LHU => {
                this.SetRegister(reg0, this.ReadHalf(address) as u32);
            },
            Opcode::LW => {
                this.SetRegister(reg0, this.ReadWord(address));
            },
            Opcode::LUI => {
                this.SetRegister(reg0, imm21 << 11);
            },
            Opcode::AUIPC => {
                this.SetRegister(reg0, this.pc + (imm21 << 11));
            },
            Opcode::SB => {
                this.WriteByte(address, (this.GetRegister(reg0) & 0xFF) as u8);
            },
            Opcode::SH => {
                this.WriteHalf(address, (this.GetRegister(reg0) & 0xFFFF) as u16);
            },
            Opcode::SW => {
                this.WriteWord(address, this.GetRegister(reg0));
            },
            Opcode::B => {
                next_pc = (this.pc as i32 + (simm26 << 2)) as u32;
            },
            Opcode::BR => {
                next_pc = this.GetRegister(reg0);
            },
            Opcode::BL => {
                this.SetRegister(reg0, this.pc + 4);
                next_pc = (this.pc as i32 + (simm21 << 2)) as u32;
            },
            Opcode::BLR => {
                this.SetRegister(reg0, this.pc + 4);
                next_pc = this.GetRegister(reg1);
            },
            Opcode::BEQ => {
                if this.GetRegister(reg0) == this.GetRegister(reg1) {
                    next_pc = (this.pc as i32 + (simm16 << 2)) as u32;
                }
            },
            Opcode::BNE => {
                if this.GetRegister(reg0) != this.GetRegister(reg1) {
                    next_pc = (this.pc as i32 + (simm16 << 2)) as u32;
                }
            },
            Opcode::BLT => {
                if (this.GetRegister(reg0) as i32) < (this.GetRegister(reg1) as i32) {
                    next_pc = (this.pc as i32 + (simm16 << 2)) as u32;
                }
            },
            Opcode::BLTU => {
                if this.GetRegister(reg0) < this.GetRegister(reg1) {
                    next_pc = (this.pc as i32 + (simm16 << 2)) as u32;
                }
            },
            Opcode::BGE => {
                if (this.GetRegister(reg0) as i32) >= (this.GetRegister(reg1) as i32) {
                    next_pc = (this.pc as i32 + (simm16 << 2)) as u32;
                }
            },
            Opcode::BGEU => {
                if this.GetRegister(reg0) >= this.GetRegister(reg1) {
                    next_pc = (this.pc as i32 + (simm16 << 2)) as u32;
                }
            },
            Opcode::SLT => {
                this.SetRegister(reg0, if this.GetRegister(reg1) as i32 < this.GetRegister(reg2) as i32 { 1 } else { 0 });
            },
            Opcode::SLTU => {
                this.SetRegister(reg0, if this.GetRegister(reg1) < this.GetRegister(reg2) { 1 } else { 0 });
            },
            Opcode::SLTI => {
                this.SetRegister(reg0, if this.GetRegister(reg1) as i32 < simm16 { 1 } else { 0 });
            },
            Opcode::SLTIU => {
                this.SetRegister(reg0, if this.GetRegister(reg1) < imm16 { 1 } else { 0 });
            },
            Opcode::ADD => {
                this.SetRegister(reg0, this.GetRegister(reg1) + this.GetRegister(reg2));
            },
            Opcode::ADDI => {
                this.SetRegister(reg0, this.GetRegister(reg1) + simm16 as u32);
            },
            Opcode::SUB => {
                this.SetRegister(reg0, this.GetRegister(reg1) - this.GetRegister(reg2));
            },
            Opcode::SUBI => {
                this.SetRegister(reg0, this.GetRegister(reg1) - simm16 as u32);
            },
            Opcode::MUL => {
                this.SetRegister(reg0, this.GetRegister(reg1) * this.GetRegister(reg2));
            },
            Opcode::MULH => {
                let product = (this.GetRegister(reg1) as i32 as i64) * (this.GetRegister(reg2) as i32 as i64);
                this.SetRegister(reg0, (product >> 32) as u32);
            },
            Opcode::MULHSU => {
                let product = (this.GetRegister(reg1) as i32 as i64) * (this.GetRegister(reg2) as i64);
                this.SetRegister(reg0, (product >> 32) as u32);
            },
            Opcode::MULHU => {
                let product = (this.GetRegister(reg1) as i64) * (this.GetRegister(reg2) as i64);
                this.SetRegister(reg0, (product >> 32) as u32);
            },
            Opcode::DIV => {
                let (dividend, divisor) = (this.GetRegister(reg1) as i32, this.GetRegister(reg2) as i32);
                this.SetRegister(reg0, if divisor == 0 { 0xFFFFFFFF } else { (dividend / divisor) as u32 });
            },
            Opcode::DIVU => {
                let (dividend, divisor) = (this.GetRegister(reg1), this.GetRegister(reg2));
                this.SetRegister(reg0, if divisor == 0 { 0xFFFFFFFF } else { dividend / divisor });
            },
            Opcode::REM => {
                let (dividend, divisor) = (this.GetRegister(reg1) as i32, this.GetRegister(reg2) as i32);
                this.SetRegister(reg0, if divisor == 0 { dividend as u32 } else { (dividend % divisor) as u32 });
            },
            Opcode::REMU => {
                let (dividend, divisor) = (this.GetRegister(reg1), this.GetRegister(reg2));
                this.SetRegister(reg0, if divisor == 0 { dividend } else { dividend % divisor });
            },
            Opcode::AND => {
                this.SetRegister(reg0, this.GetRegister(reg1) & this.GetRegister(reg2));
            },
            Opcode::ANDI => {
                this.SetRegister(reg0, this.GetRegister(reg1) & imm16);
            },
            Opcode::OR => {
                this.SetRegister(reg0, this.GetRegister(reg1) | this.GetRegister(reg2));
            },
            Opcode::ORI => {
                this.SetRegister(reg0, this.GetRegister(reg1) | imm16);
            },
            Opcode::XOR => {
                this.SetRegister(reg0, this.GetRegister(reg1) ^ this.GetRegister(reg2));
            },
            Opcode::XORI => {
                this.SetRegister(reg0, this.GetRegister(reg1) ^ imm16);
            },
            Opcode::SLL => {
                this.SetRegister(reg0, this.GetRegister(reg1) << (this.GetRegister(reg2) & 0x1F));
            },
            Opcode::SLLI => {
                this.SetRegister(reg0, this.GetRegister(reg1) << (imm16 & 0x1F));
            },
            Opcode::SRL => {
                this.SetRegister(reg0, this.GetRegister(reg1) >> (this.GetRegister(reg2) & 0x1F));
            },
            Opcode::SRLI => {
                this.SetRegister(reg0, this.GetRegister(reg1) >> (imm16 & 0x1F));
            },
            Opcode::SRA => {
                this.SetRegister(reg0, ((this.GetRegister(reg1) as i32) >> ((this.GetRegister(reg2) & 0x1F) as i32)) as u32);
            },
            Opcode::SRAI => {
                this.SetRegister(reg0, ((this.GetRegister(reg1) as i32) >> ((imm16 & 0x1F) as i32)) as u32);
            },
            Opcode::CSRR => {
                this.SetRegister(reg0, this.ReadCSR(imm16));
            },
            Opcode::CSRW => {
                this.WriteCSR(imm16, this.GetRegister(reg1));
            },
            Opcode::ECALL => {
                this.Trap(TrapCause::SystemCall as u32, this.pc + 4, 0);
                this.instruction_counter += 1;
                return;
            },
            Opcode::ERET => {
                next_pc = this.trap_pc;
                (this.interrupt_enable, this.previous_interrupt_enable) = (this.previous_interrupt_enable, true);
                (this.user_mode, this.previous_user) = (this.previous_user, false);
            },
            Opcode::WFI => {
                this.WaitForInterrupt();
            },
            Opcode::HLT => {
                this.halted = true;
            }
        }

        this.pc = next_pc;
        this.instruction_counter += 1;
    }

    fn Receive(&mut this, character: u8) {
        this.uart_mutex.Lock();

        while this.uart_rx_ready {
            this.uart_changed.Wait(&mut this.uart_mutex);
        }

        this.uart_rx = character;
        this.uart_rx_ready = true;
        this.uart_changed.Signal();
        this.uart_mutex.Unlock();
    }

    fn Receive(&mut this, mut sequence: *i8) {
        while *sequence != '\0' {
            this.Receive(*sequence as u8);
            sequence += 1;
        }
    }

    fn UartThread(&mut this) {
        loop {
            let character = _getch();

            if character == 0 || character == 0xE0 {
                match _getch() {
                    0x48 => this.Receive("\x1B[A"),
                    0x50 => this.Receive("\x1B[B"),
                    0x4D => this.Receive("\x1B[C"),
                    0x4B => this.Receive("\x1B[D"),
                    0x47 => this.Receive("\x1B[H"),
                    0x4F => this.Receive("\x1B[F"),
                    0x53 => this.Receive("\x1B[3~"),
                    _ => ()
                }
            } else {
                this.Receive(character as u8);
            }
        }
    }

    pub fn Emulate(&mut this) {
        let mut uart_thread = Thread(Emulator::UartThread as ThreadFunction, this);
        uart_thread.Detach();

        while !this.halted {
            this.Tick();
        }
    }
}
