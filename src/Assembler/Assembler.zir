#[include "std/str", "std/vec", "src/Assembler/AST.zir", "src/Common/Object.zir", "src/Common/Logger.zir",
    "src/Common/Instruction.zir", "src/Common/Section.zir", "src/Common/Symbol.zir", "src/Common/Relocation.zir",
    "src/Common/NameIndex.zir" : *]

class Assembler {
    section: SectionType,
    sections: Vector<Vector<u8>>,
    symbols: Vector<Symbol>,
    symbol_index: NameIndex,
    relocations: Vector<Relocation>,
    globals: NameIndex,
    externs: NameIndex,
    quiet: bool = false;

    fn Error(&this, message: *i8, span: SourceSpan) {
        if !this.quiet {
            Logger::Log(message, span, LogSeverity::Error);
        }
    }

    fn Error(&this, message: &String, span: SourceSpan) {
        if !this.quiet {
            Logger::Log(message, span, LogSeverity::Error);
        }
    }

    fn AssembleQuiet(&mut this, node: *ASTExpression) -> u32 {
        this.quiet = true;
        let value = this.AssembleExpression(node);
        this.quiet = false;
        value
    }

    fn WriteByte(&mut this, section: SectionType, value: u8) {
        this.sections[section as usize].PushBack(value);
    }

    fn WriteHalf(&mut this, section: SectionType, value: u16) {
        this.WriteByte(section, value as u8);
        this.WriteByte(section, (value >> 8) as u8);
    }

    fn WriteWord(&mut this, section: SectionType, value: u32) {
        this.WriteByte(section, value as u8);
        this.WriteByte(section, (value >> 8) as u8);
        this.WriteByte(section, (value >> 16) as u8);
        this.WriteByte(section, (value >> 24) as u8);
    }

    fn GetSectionSize(&mut this, section: SectionType) -> u32 {
        this.sections[section as usize].Length() as u32
    }

    fn IsRelocatable(&mut this, node: *ASTExpression) -> bool {
        match node->kind {
            ASTExpressionKind::Identifier => true,
            ASTExpressionKind::Binary => {
                let binary = node as *ASTBinaryExpression;
                this.IsRelocatable(binary->left) || this.IsRelocatable(binary->right)
            },
            ASTExpressionKind::Unary => this.IsRelocatable((node as *ASTUnaryExpression)->operand),
            _ => false
        }
    }

    fn RelocationSymbol(&mut this, node: *ASTExpression) -> String {
        if node->kind == ASTExpressionKind::Identifier {
            return (node as *ASTIdentifierExpression)->name;
        }

        this.Error("A relocatable expression must be a single symbol.", node->span);
        String()
    }

    fn AssembleCSRExpression(&mut this, node: *ASTExpression) -> u32 {
        if node->kind == ASTExpressionKind::Identifier {
            let &value = (node as *ASTIdentifierExpression)->name;

            if value == "status" { 0 }
            else if value == "ienable" { 1 }
            else if value == "ipending" { 2 }
            else if value == "epc" { 3 }
            else if value == "cause" { 4 }
            else if value == "vector" { 5 }
            else if value == "scratch" { 6 }
            else if value == "badaddr" { 7 }
            else if value == "ptbase" { 8 }
            else if value == "asid" { 9 }
            else if value == "tlbflush" { 10 }
            else if value == "cycle" { 16 }
            else if value == "instret" { 17 }
            else if value == "time" { 18 }
            else {
                this.AssembleExpression(node)
            }
        } else {
            this.AssembleExpression(node)
        }
    }

    fn AssembleCSRImmediate(&mut this, node: *ASTExpression) -> u32 {
        let value = this.AssembleExpression(node);

        if value > CSR_IMMEDIATE_MASK {
            this.Error("CSR immediate must be between 0 and 31.", node->span);
        }

        value & CSR_IMMEDIATE_MASK
    }

    fn CSRWord(&this, opcode: Opcode, destination: u32, csr: u32, source: u32) -> u32 {
        (opcode as u32 << OPCODE_SHIFT) | (destination << REG0_SHIFT) | ((source & CSR_IMMEDIATE_MASK) << REG1_SHIFT) | (csr & IMM16_MASK)
    }

    fn AssembleExpression(&mut this, node: *ASTExpression) -> u32 {
        match node->kind {
            ASTExpressionKind::Address => this.GetSectionSize(this.section),
            ASTExpressionKind::Literal => {
                let literal = node as *ASTLiteral;

                match literal->kind {
                    ASTLiteralKind::Integer => (literal as *ASTIntegerLiteral)->value,
                    ASTLiteralKind::Character => (literal as *ASTCharacterLiteral)->value,
                    ASTLiteralKind::String => {
                        this.Error("A string literal cannot be used as a value.", node->span);
                        0
                    }
                }
            },
            ASTExpressionKind::Register => (node as *ASTRegisterExpression)->index,
            ASTExpressionKind::Identifier => {
                let &value = (node as *ASTIdentifierExpression)->name;

                if let Option<usize>::Some(index) = this.symbol_index.Find(value) {
                    return this.symbols[index].offset;
                }

                if !this.externs.Contains(value) {
                    this.Error("Unknown identifier: '" + value + "'.", node->span);
                }

                0
            },
            ASTExpressionKind::Binary => {
                let binary = node as *ASTBinaryExpression;
                let left = this.AssembleExpression(binary->left);
                let right = this.AssembleExpression(binary->right);

                if (binary->kind == ASTBinaryKind::Divide || binary->kind == ASTBinaryKind::Modulo) && right == 0 {
                    this.Error("Division by zero.", node->span);
                    return 0;
                }

                match binary->kind {
                    ASTBinaryKind::Add => left + right,
                    ASTBinaryKind::Subtract => left - right,
                    ASTBinaryKind::Multiply => left * right,
                    ASTBinaryKind::Divide => left / right,
                    ASTBinaryKind::Modulo => left % right,
                    ASTBinaryKind::LeftShift => left << right,
                    ASTBinaryKind::RightShift => left >> right,
                    ASTBinaryKind::BitwiseAnd => left & right,
                    ASTBinaryKind::BitwiseOr => left | right,
                    ASTBinaryKind::BitwiseXor => left ^ right
                }
            },
            ASTExpressionKind::Unary => {
                let unary = node as *ASTUnaryExpression;
                let operand = this.AssembleExpression(unary->operand);

                match unary->kind {
                    ASTUnaryKind::Negate => 0 - operand,
                    ASTUnaryKind::Not => !operand
                }
            }
        }
    }

    fn Alignment(&mut this, node: *ASTExpression) -> u32 {
        let align = this.AssembleExpression(node);

        if align == 0 {
            this.Error("Alignment must be greater than zero.", node->span);
            return 1;
        }

        align
    }

    fn Opcode(&this, mnemonic: Mnemonic) -> Opcode {
        match mnemonic {
            Mnemonic::Lb => Opcode::LB,
            Mnemonic::Lbu => Opcode::LBU,
            Mnemonic::Lh => Opcode::LH,
            Mnemonic::Lhu => Opcode::LHU,
            Mnemonic::Lw => Opcode::LW,
            Mnemonic::Lui => Opcode::LUI,
            Mnemonic::Auipc => Opcode::AUIPC,
            Mnemonic::Sb => Opcode::SB,
            Mnemonic::Sh => Opcode::SH,
            Mnemonic::Sw => Opcode::SW,
            Mnemonic::B => Opcode::B,
            Mnemonic::Br => Opcode::BR,
            Mnemonic::Bl => Opcode::BL,
            Mnemonic::Blr => Opcode::BLR,
            Mnemonic::Beq => Opcode::BEQ,
            Mnemonic::Bne => Opcode::BNE,
            Mnemonic::Blt => Opcode::BLT,
            Mnemonic::Bltu => Opcode::BLTU,
            Mnemonic::Bge => Opcode::BGE,
            Mnemonic::Bgeu => Opcode::BGEU,
            Mnemonic::Slt => Opcode::SLT,
            Mnemonic::Sltu => Opcode::SLTU,
            Mnemonic::Slti => Opcode::SLTI,
            Mnemonic::Sltiu => Opcode::SLTIU,
            Mnemonic::Add => Opcode::ADD,
            Mnemonic::Addi => Opcode::ADDI,
            Mnemonic::Sub => Opcode::SUB,
            Mnemonic::Subi => Opcode::SUBI,
            Mnemonic::Mul => Opcode::MUL,
            Mnemonic::Mulh => Opcode::MULH,
            Mnemonic::Mulhsu => Opcode::MULHSU,
            Mnemonic::Mulhu => Opcode::MULHU,
            Mnemonic::Div => Opcode::DIV,
            Mnemonic::Divu => Opcode::DIVU,
            Mnemonic::Rem => Opcode::REM,
            Mnemonic::Remu => Opcode::REMU,
            Mnemonic::And => Opcode::AND,
            Mnemonic::Andi => Opcode::ANDI,
            Mnemonic::Or => Opcode::OR,
            Mnemonic::Ori => Opcode::ORI,
            Mnemonic::Xor => Opcode::XOR,
            Mnemonic::Xori => Opcode::XORI,
            Mnemonic::Sll => Opcode::SLL,
            Mnemonic::Slli => Opcode::SLLI,
            Mnemonic::Srl => Opcode::SRL,
            Mnemonic::Srli => Opcode::SRLI,
            Mnemonic::Sra => Opcode::SRA,
            Mnemonic::Srai => Opcode::SRAI,
            Mnemonic::Csrrw => Opcode::CSRRW,
            Mnemonic::Csrrs => Opcode::CSRRS,
            Mnemonic::Csrrc => Opcode::CSRRC,
            Mnemonic::Csrrwi => Opcode::CSRRWI,
            Mnemonic::Csrrsi => Opcode::CSRRSI,
            Mnemonic::Csrrci => Opcode::CSRRCI,
            Mnemonic::Ecall => Opcode::ECALL,
            Mnemonic::Ebreak => Opcode::EBREAK,
            Mnemonic::Eret => Opcode::ERET,
            Mnemonic::Wfi => Opcode::WFI,
            Mnemonic::Hlt => Opcode::HLT,
            _ => Opcode::NOP
        }
    }

    fn MeasureDirective(&mut this, directive: *ASTDirectiveStatement, section_sizes: &mut Vector<u32>) {
        let &operands = directive->operands;

        match directive->directive {
            Directive::Text => {
                this.section = SectionType::Text;
            },
            Directive::Data => {
                this.section = SectionType::Data;
            },
            Directive::Byte => {
                section_sizes[this.section as usize] += operands.Length() as u32;
            },
            Directive::Half => {
                section_sizes[this.section as usize] += (operands.Length() * 2) as u32;
            },
            Directive::Word => {
                section_sizes[this.section as usize] += (operands.Length() * 4) as u32;
            },
            Directive::String => {
                for operand in operands {
                    section_sizes[this.section as usize] += ((operand->expression as *ASTStringLiteral)->value.Length() + 1) as u32;
                }
            },
            Directive::Align => {
                let align = this.Alignment(operands[0]->expression);
                let remainder = section_sizes[this.section as usize] % align;

                if remainder != 0 {
                    section_sizes[this.section as usize] += align - remainder;
                }
            },
            Directive::Space => {
                section_sizes[this.section as usize] += this.AssembleExpression(operands[0]->expression);
            },
            Directive::Global => {
                for operand in operands {
                    if operand->expression->kind == ASTExpressionKind::Identifier {
                        let &value = (operand->expression as *ASTIdentifierExpression)->name;

                        if !this.globals.Contains(value) {
                            this.globals.Insert(value);

                            if let Option<usize>::Some(index) = this.symbol_index.Find(value) {
                                this.symbols[index].binding = BindingType::Global;
                            }
                        }
                    }
                }
            },
            Directive::Extern => {
                for operand in operands {
                    if operand->expression->kind == ASTExpressionKind::Identifier {
                        let &value = (operand->expression as *ASTIdentifierExpression)->name;

                        this.externs.Insert(value);
                    }
                }
            }
        }
    }

    fn MeasureInstruction(&mut this, instruction: *ASTInstructionStatement) -> u32 {
        let &operands = instruction->operands;

        if instruction->mnemonic == Mnemonic::La {
            return 8;
        }

        if instruction->mnemonic != Mnemonic::Li || this.IsRelocatable(operands[1]->expression) {
            return if instruction->mnemonic == Mnemonic::Li { 8 } else { 4 };
        }

        let immediate = this.AssembleExpression(operands[1]->expression);

        if (immediate <= IMM16_SMAX) || (immediate >= IMM16_SMIN) {
            4
        } else if (immediate & IMM11_MASK) == 0 {
            4
        } else {
            8
        }
    }

    fn EmitDirective(&mut this, directive: *ASTDirectiveStatement, offset: u32) {
        let &operands = directive->operands;

        match directive->directive {
            Directive::Text => {
                this.section = SectionType::Text;
            },
            Directive::Data => {
                this.section = SectionType::Data;
            },
            Directive::Byte => {
                for operand in operands {
                    this.WriteByte(this.section, this.AssembleExpression(operand->expression) as u8);
                }
            },
            Directive::Half => {
                for operand in operands {
                    this.WriteHalf(this.section, this.AssembleExpression(operand->expression) as u16);
                }
            },
            Directive::Word => {
                for operand in operands {
                    if this.IsRelocatable(operand->expression) {
                        let label = this.RelocationSymbol(operand->expression);
                        this.relocations.PushBack(Relocation(this.section, offset, RelocationType::Absolute32, label));
                        this.WriteWord(this.section, 0);
                    } else {
                        this.WriteWord(this.section, this.AssembleExpression(operand->expression));
                    }
                }
            },
            Directive::String => {
                for operand in operands {
                    let &value = (operand->expression as *ASTStringLiteral)->value;

                    for i in 0..value.Length() {
                        this.WriteByte(this.section, value.Data()[i] as u8);
                    } this.WriteByte(this.section, 0);
                }
            },
            Directive::Align => {
                this.quiet = true;
                let align = this.Alignment(operands[0]->expression);
                this.quiet = false;
                let remainder = offset % align;

                if remainder != 0 {
                    for _ in 0..(align - remainder) {
                        this.WriteByte(this.section, 0);
                    }
                }
            },
            Directive::Space => {
                for _ in 0..this.AssembleQuiet(operands[0]->expression) {
                    this.WriteByte(this.section, 0);
                }
            },
            _ => {}
        }
    }

    fn EmitInstruction(&mut this, instruction: *ASTInstructionStatement, mut offset: u32) {
        let mnemonic = instruction->mnemonic;
        let &operands = instruction->operands;
        let remainder = offset % 4;

        if remainder != 0 {
            for _ in 0..(4 - remainder) {
                this.WriteByte(this.section, 0);
            } offset += (4 - remainder);
        }

        if mnemonic == Mnemonic::La {
            let register = this.AssembleExpression(operands[0]->expression);
            let label = this.RelocationSymbol(operands[1]->expression);
            this.WriteWord(this.section, (Opcode::AUIPC as u32 << OPCODE_SHIFT) | (register << REG0_SHIFT) | (0 & IMM21_MASK));
            this.WriteWord(this.section, (Opcode::ADDI as u32 << OPCODE_SHIFT) | (register << REG0_SHIFT) | (register << REG1_SHIFT) | (0 & IMM16_MASK));
            this.relocations.PushBack(Relocation(this.section, offset, RelocationType::PcRelativeUpper21, label));
            this.relocations.PushBack(Relocation(this.section, offset + 4, RelocationType::PcRelativeLower11, label));
            return;
        }

        if mnemonic == Mnemonic::Li {
            let register = this.AssembleExpression(operands[0]->expression);

            if this.IsRelocatable(operands[1]->expression) {
                let label = this.RelocationSymbol(operands[1]->expression);
                this.WriteWord(this.section, (Opcode::LUI as u32 << OPCODE_SHIFT) | (register << REG0_SHIFT) | (0 & IMM21_MASK));
                this.WriteWord(this.section, (Opcode::ORI as u32 << OPCODE_SHIFT) | (register << REG0_SHIFT) | (register << REG1_SHIFT) | (0 & IMM16_MASK));
                this.relocations.PushBack(Relocation(this.section, offset, RelocationType::AbsoluteUpper21, label));
                this.relocations.PushBack(Relocation(this.section, offset + 4, RelocationType::AbsoluteLower11, label));
            } else {
                let immediate = this.AssembleQuiet(operands[1]->expression);

                if (immediate <= IMM16_SMAX) || (immediate >= IMM16_SMIN) {
                    this.WriteWord(this.section, (Opcode::ADDI as u32 << OPCODE_SHIFT) | (register << REG0_SHIFT) | (0u32 << REG1_SHIFT) | (immediate & IMM16_MASK));
                } else if (immediate & IMM11_MASK) == 0 {
                    this.WriteWord(this.section, (Opcode::LUI as u32 << OPCODE_SHIFT) | (register << REG0_SHIFT) | ((immediate >> 11) & IMM21_MASK));
                } else {
                    this.WriteWord(this.section, (Opcode::LUI as u32 << OPCODE_SHIFT) | (register << REG0_SHIFT) | ((immediate >> 11) & IMM21_MASK));
                    this.WriteWord(this.section, (Opcode::ORI as u32 << OPCODE_SHIFT) | (register << REG0_SHIFT) | (register << REG1_SHIFT) | (immediate & IMM11_MASK));
                }
            }

            return;
        }

        let mut opcode = Opcode::NOP;
        let (mut pseudo, mut reverse, mut _zero, mut negative, mut register) = (true, false, true, false, true);
        if mnemonic == Mnemonic::Mv { (opcode, register) = (Opcode::ADDI, false); }
        else if mnemonic == Mnemonic::Not { (opcode, _zero, negative, register) = (Opcode::XORI, false, true, false); }
        else if mnemonic == Mnemonic::Neg { (opcode, reverse) = (Opcode::SUB, true); }
        else if mnemonic == Mnemonic::Seqz { (opcode, _zero, register) = (Opcode::SLTIU, false, false); }
        else if mnemonic == Mnemonic::Snez { (opcode, reverse) = (Opcode::SLTU, true); }
        else if mnemonic == Mnemonic::Sltz { opcode = Opcode::SLT; }
        else if mnemonic == Mnemonic::Sgtz { (opcode, reverse) = (Opcode::SLT, true); }
        else { pseudo = false; }

        if pseudo {
            let destination = this.AssembleExpression(operands[0]->expression);
            let source = this.AssembleExpression(operands[1]->expression);
            let other = if _zero { 0 } else if negative { -1 as u32 } else { 1 };
            let (left, right) = if reverse { (other, source) } else { (source, other) };
            this.WriteWord(this.section, (opcode as u32 << OPCODE_SHIFT) | (destination << REG0_SHIFT) | (left << REG1_SHIFT) | (if register { right << REG2_SHIFT } else { right & IMM16_MASK }));
            return;
        }

        pseudo = true;
        if mnemonic == Mnemonic::Beqz { opcode = Opcode::BEQ; }
        else if mnemonic == Mnemonic::Bnez { opcode = Opcode::BNE; }
        else if mnemonic == Mnemonic::Blez { (opcode, reverse) = (Opcode::BGE, true); }
        else if mnemonic == Mnemonic::Bgez { opcode = Opcode::BGE; }
        else if mnemonic == Mnemonic::Bltz { opcode = Opcode::BLT; }
        else if mnemonic == Mnemonic::Bgtz { (opcode, reverse) = (Opcode::BLT, true); }
        else if mnemonic == Mnemonic::Bgt { (opcode, reverse, _zero) = (Opcode::BLT, true, false); }
        else if mnemonic == Mnemonic::Ble { (opcode, reverse, _zero) = (Opcode::BGE, true, false); }
        else if mnemonic == Mnemonic::Bgtu { (opcode, reverse, _zero) = (Opcode::BLTU, true, false); }
        else if mnemonic == Mnemonic::Bleu { (opcode, reverse, _zero) = (Opcode::BGEU, true, false); }
        else { pseudo = false; }

        if pseudo {
            let index: usize = if _zero { 1 } else { 2 };
            let target = this.AssembleExpression(operands[index]->expression);

            if this.IsRelocatable(operands[index]->expression) {
                this.relocations.PushBack(Relocation(this.section, offset, RelocationType::Branch16, this.RelocationSymbol(operands[index]->expression)));
            }

            let source = this.AssembleExpression(operands[0]->expression);
            let other = if _zero { 0 } else { this.AssembleExpression(operands[1]->expression) };
            let (left, right) = if reverse { (other, source) } else { (source, other) };
            this.WriteWord(this.section, (opcode as u32 << OPCODE_SHIFT) | (left << REG0_SHIFT) | (right << REG1_SHIFT) | (target & IMM16_MASK));
            return;
        }

        if mnemonic == Mnemonic::Csrr {
            let destination = this.AssembleExpression(operands[0]->expression);
            this.WriteWord(this.section, this.CSRWord(Opcode::CSRRS, destination, this.AssembleCSRExpression(operands[1]->expression), 0));
            return;
        }

        if mnemonic == Mnemonic::Csrw || mnemonic == Mnemonic::Csrs || mnemonic == Mnemonic::Csrc {
            let csr_opcode = if mnemonic == Mnemonic::Csrw { Opcode::CSRRW } else if mnemonic == Mnemonic::Csrs { Opcode::CSRRS } else { Opcode::CSRRC };
            let csr = this.AssembleCSRExpression(operands[0]->expression);
            this.WriteWord(this.section, this.CSRWord(csr_opcode, 0, csr, this.AssembleExpression(operands[1]->expression)));
            return;
        }

        if mnemonic == Mnemonic::Csrwi || mnemonic == Mnemonic::Csrsi || mnemonic == Mnemonic::Csrci {
            let csr_opcode = if mnemonic == Mnemonic::Csrwi { Opcode::CSRRWI } else if mnemonic == Mnemonic::Csrsi { Opcode::CSRRSI } else { Opcode::CSRRCI };
            let csr = this.AssembleCSRExpression(operands[0]->expression);
            this.WriteWord(this.section, this.CSRWord(csr_opcode, 0, csr, this.AssembleCSRImmediate(operands[1]->expression)));
            return;
        }

        if mnemonic == Mnemonic::Rdcycle || mnemonic == Mnemonic::Rdtime || mnemonic == Mnemonic::Rdinstret {
            let csr = if mnemonic == Mnemonic::Rdcycle { CSR::CYCLE } else if mnemonic == Mnemonic::Rdtime { CSR::TIME } else { CSR::INSTRET };
            this.WriteWord(this.section, this.CSRWord(Opcode::CSRRS, this.AssembleExpression(operands[0]->expression), csr as u32, 0));
            return;
        }

        opcode = this.Opcode(mnemonic);
        let mut word = (opcode as u32 << OPCODE_SHIFT);

        if opcode >= Opcode::LB && opcode <= Opcode::SW {
            word |= (this.AssembleExpression(operands[0]->expression) << REG0_SHIFT);

            if opcode == Opcode::LUI || opcode == Opcode::AUIPC {
                word |= (this.AssembleExpression(operands[1]->expression) & IMM21_MASK);
            } else {
                word |= (this.AssembleExpression(operands[1]->expression) << REG1_SHIFT);
                word |= (this.AssembleExpression(operands[1]->offset) & IMM16_MASK);
            }
        } else if opcode == Opcode::B {
            word |= (((this.AssembleExpression(operands[0]->expression) - offset) >> 2) & IMM26_MASK);

            if this.IsRelocatable(operands[0]->expression) {
                this.relocations.PushBack(Relocation(this.section, offset, RelocationType::Branch26, this.RelocationSymbol(operands[0]->expression)));
            }
        } else if opcode == Opcode::BL {
            word |= (this.AssembleExpression(operands[0]->expression) << REG0_SHIFT);
            word |= (((this.AssembleExpression(operands[1]->expression) - offset) >> 2) & IMM21_MASK);

            if this.IsRelocatable(operands[1]->expression) {
                this.relocations.PushBack(Relocation(this.section, offset, RelocationType::Branch21, this.RelocationSymbol(operands[1]->expression)));
            }
        } else if opcode == Opcode::BR {
            word |= (this.AssembleExpression(operands[0]->expression) << REG0_SHIFT);
        } else if opcode == Opcode::BLR {
            word |= (this.AssembleExpression(operands[0]->expression) << REG0_SHIFT);
            word |= (this.AssembleExpression(operands[1]->expression) << REG1_SHIFT);
        } else if opcode >= Opcode::BEQ && opcode <= Opcode::BGEU {
            word |= (this.AssembleExpression(operands[0]->expression) << REG0_SHIFT);
            word |= (this.AssembleExpression(operands[1]->expression) << REG1_SHIFT);
            word |= (((this.AssembleExpression(operands[2]->expression) - offset) >> 2) & IMM16_MASK);

            if this.IsRelocatable(operands[2]->expression) {
                this.relocations.PushBack(Relocation(this.section, offset, RelocationType::Branch16, this.RelocationSymbol(operands[2]->expression)));
            }
        } else if opcode >= Opcode::SLT && opcode <= Opcode::SLTIU {
            word |= (this.AssembleExpression(operands[0]->expression) << REG0_SHIFT);
            word |= (this.AssembleExpression(operands[1]->expression) << REG1_SHIFT);

            if opcode == Opcode::SLT || opcode == Opcode::SLTU {
                word |= (this.AssembleExpression(operands[2]->expression) << REG2_SHIFT);
            } else {
                word |= (this.AssembleExpression(operands[2]->expression) & IMM16_MASK);
            }
        } else if opcode >= Opcode::ADD && opcode <= Opcode::SRAI {
            word |= (this.AssembleExpression(operands[0]->expression) << REG0_SHIFT);
            word |= (this.AssembleExpression(operands[1]->expression) << REG1_SHIFT);

            if (Opcode::ADD as u32 % 2 == opcode as u32 % 2) || (opcode >= Opcode::MUL && opcode <= Opcode::REMU) {
                word |= (this.AssembleExpression(operands[2]->expression) << REG2_SHIFT);
            } else {
                word |= (this.AssembleExpression(operands[2]->expression) & IMM16_MASK);
            }
        } else if opcode >= Opcode::CSRRW && opcode <= Opcode::CSRRCI {
            let destination = this.AssembleExpression(operands[0]->expression);
            let csr = this.AssembleCSRExpression(operands[1]->expression);
            let source = if opcode >= Opcode::CSRRWI { this.AssembleCSRImmediate(operands[2]->expression) } else { this.AssembleExpression(operands[2]->expression) };
            word = this.CSRWord(opcode, destination, csr, source);
        }

        this.WriteWord(this.section, word);
    }

    pub fn Assemble(&mut this, module: *ASTModule) -> Object {
        this.section = SectionType::Text;
        this.sections.Resize(SECTION_COUNT);

        let mut section_sizes: Vector<u32>;
        section_sizes.Resize(SECTION_COUNT);

        for i in 0..section_sizes.Length() {
            section_sizes[i] = 0;
        }

        for statement in module->statements {
            match statement->kind {
                ASTStatementKind::Label => {
                    let &name = (statement as *ASTLabelStatement)->name;

                    if this.symbol_index.Contains(name) {
                        Logger::Log("Duplicate symbol: '" + name + "'.", statement->span, LogSeverity::Error);
                    } else {
                        let binding = if this.globals.Contains(name) { BindingType::Global } else { BindingType::Local };
                        this.symbol_index.Insert(name);
                        this.symbols.PushBack(Symbol(name, this.section, section_sizes[this.section as usize], binding));
                    }
                },
                ASTStatementKind::Directive => {
                    this.MeasureDirective(statement as *ASTDirectiveStatement, section_sizes);
                },
                ASTStatementKind::Instruction => {
                    let remainder = section_sizes[this.section as usize] % 4;

                    if remainder != 0 {
                        section_sizes[this.section as usize] += (4 - remainder);
                    }

                    section_sizes[this.section as usize] += this.MeasureInstruction(statement as *ASTInstructionStatement);
                }
            }
        }

        this.section = SectionType::Text;

        for statement in module->statements {
            let offset = this.GetSectionSize(this.section);

            match statement->kind {
                ASTStatementKind::Directive => this.EmitDirective(statement as *ASTDirectiveStatement, offset),
                ASTStatementKind::Instruction => this.EmitInstruction(statement as *ASTInstructionStatement, offset),
                _ => {}
            }
        }

        for section in this.sections {
            let remainder = section.Length() % 4;

            if remainder != 0 {
                for _ in 0..(4 - remainder) {
                    section.PushBack(0);
                }
            }
        }

        let mut object = Object();
        object.sections.Resize(this.sections.Length());

        for i in 0..this.sections.Length() {
            let section = this.sections[i];

            for j in 0..(section.Length() / 4) {
                let mut word = section[j * 4] as u32;
                word |= (section[j * 4 + 1] as u32) << 8;
                word |= (section[j * 4 + 2] as u32) << 16;
                word |= (section[j * 4 + 3] as u32) << 24;
                object.sections[i].PushBack(word);
            }
        }

        this.sections.Clear();
        object.symbols.Swap(this.symbols);
        object.relocations.Swap(this.relocations);
        this.symbol_index.Clear();
        this.globals.Clear();
        this.externs.Clear();
        object
    }
}
