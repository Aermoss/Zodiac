#[include "std/str", "std/vec", "src/Assembler/Token.zir", "src/Common/Logger.zir", "src/Common/Source.zir" : *]

class Lexer {
    file: *SourceFile = null,
    file_id: u32 = 0,
    length: usize = 0,
    index: usize = 0;

    Lexer(&mut this, text: &String, path: &String) {
        this.file_id = Sources()->Add(path, text);
        this.file = Sources()->File(this.file_id);
        this.length = text.Length();
    }

    fn IsDigit(&this, character: i8) -> bool {
        character >= '0' && character <= '9'
    }

    fn IsHexDigit(&this, character: i8) -> bool {
        (character >= '0' && character <= '9') || (character >= 'a' && character <= 'f') || (character >= 'A' && character <= 'F')
    }

    fn IsBinDigit(&this, character: i8) -> bool {
        character == '0' || character == '1'
    }

    fn IsOctDigit(&this, character: i8) -> bool {
        character >= '0' && character <= '7'
    }

    fn IsAlpha(&this, character: i8) -> bool {
        (character >= 'a' && character <= 'z') || (character >= 'A' && character <= 'Z') || character == '_' || character == '.'
    }

    fn IsAlphaNum(&this, character: i8) -> bool {
        this.IsAlpha(character) || this.IsDigit(character)
    }

    fn CurrentChar(&this) -> i8 {
        if this.index >= this.length { return '\0'; }
        this.file->text.Data()[this.index]
    }

    fn PeekChar(&this, offset: usize) -> i8 {
        let peek_index = this.index + offset;
        if peek_index >= this.length { return '\0'; }
        this.file->text.Data()[peek_index]
    }

    fn Span(&this, start: usize) -> SourceSpan {
        SourceSpan { file: this.file_id, start: start as u32, end: this.index as u32 }
    }

    fn Make(&this, _type: TokenType, start: usize) -> Token {
        let mut token: Token;
        (token._type, token.span) = (_type, this.Span(start));
        token
    }

    pub fn Text(&this, span: SourceSpan) -> String {
        String(this.file->text, span.start as usize, (span.end - span.start) as usize)
    }

    pub fn Unescape(&mut this, span: SourceSpan) -> String {
        let saved = this.index;
        this.index = span.start as usize;
        let mut value = String();
        this.ScanQuoted(value, false);
        this.index = saved;
        value
    }

    fn IsEscapeDigit(&this, character: i8, hexadecimal: bool) -> bool {
        if hexadecimal { this.IsHexDigit(character) } else { this.IsOctDigit(character) }
    }

    fn ScanDigits(&mut this, hexadecimal: bool) -> String {
        let mut digits = String();

        while this.IsEscapeDigit(this.CurrentChar(), hexadecimal) {
            digits += this.CurrentChar();
            this.index += 1;
        }

        digits
    }

    fn ScanQuoted(&mut this, value: &mut String, report: bool) {
        let start = this.index;
        let quote = this.CurrentChar();
        this.index += 1;

        while this.CurrentChar() != quote && this.CurrentChar() != '\n' && this.CurrentChar() != '\0' {
            if this.CurrentChar() != '\\' {
                value += this.CurrentChar();
                this.index += 1;
                continue;
            }

            let escape = this.index;
            this.index += 1;
            if this.CurrentChar() == '\0' { break; }
            let escaped = this.CurrentChar();

            let simple: i8 = match escaped {
                '\'' => '\'',
                '"' => '"',
                '?' => '?',
                '\\' => '\\',
                'a' => '\a',
                'b' => '\b',
                'f' => '\f',
                'n' => '\n',
                'r' => '\r',
                't' => '\t',
                'v' => '\v',
                _ => '\0'
            };

            if simple != '\0' {
                value += simple;
                this.index += 1;
                continue;
            }

            let hexadecimal = escaped == 'x';
            if hexadecimal { this.index += 1; }
            let digits = this.ScanDigits(hexadecimal);

            if digits.Empty() {
                if report { Logger::Log(if hexadecimal { "Invalid hexadecimal escape sequence." } else { "Invalid octal escape sequence." }, this.Span(escape), LogSeverity::Error); }
                continue;
            }

            if report && digits.Length() > (if hexadecimal { 2 } else { 3 }) {
                Logger::Log(if hexadecimal { "Hexadecimal escape sequence too long." } else { "Octal escape sequence too long." }, this.Span(escape), LogSeverity::Error);
            }

            value += digits.ToInteger(if hexadecimal { 16 } else { 8 }).Unwrap() as i8;
        }

        if this.CurrentChar() == quote {
            this.index += 1;
        } else if report {
            Logger::Log("Unterminated string literal.", this.Span(start), LogSeverity::Error);
        }
    }

    fn LexNumber(&mut this) -> Token {
        let start = this.index;

        if this.CurrentChar() == '0' {
            this.index += 1;
            let prefix = this.CurrentChar();

            if prefix == 'x' || prefix == 'X' {
                this.index += 1;
                while this.IsHexDigit(this.CurrentChar()) { this.index += 1; }
            } else if prefix == 'b' || prefix == 'B' {
                this.index += 1;
                while this.IsBinDigit(this.CurrentChar()) { this.index += 1; }
            } else if prefix == 'o' || prefix == 'O' {
                this.index += 1;
                while this.IsOctDigit(this.CurrentChar()) { this.index += 1; }
            } else {
                while this.IsDigit(this.CurrentChar()) { this.index += 1; }
            }
        } else {
            while this.IsDigit(this.CurrentChar()) { this.index += 1; }
        }

        this.Make(TokenType::Number, start)
    }

    fn LexIdentifier(&mut this) -> Token {
        let start = this.index;

        loop {
            let byte = this.CurrentChar() as u8;

            if byte > 0x7F {
                this.index += if (byte & 0xE0) == 0xC0 { 2 } else if (byte & 0xF0) == 0xE0 { 3 } else { 4 };
                if this.index > this.length { this.index = this.length; }
                continue;
            }

            let accepted = if this.index > start { this.IsAlphaNum(byte as i8) } else { this.IsAlpha(byte as i8) };

            if accepted {
                this.index += 1;
            } else {
                break;
            }
        }

        this.Make(TokenType::Identifier, start)
    }

    fn LexSymbol(&mut this) -> Token {
        let start = this.index;
        let (current, next) = (this.CurrentChar(), this.PeekChar(1));

        let _type = match current {
            '+' => TokenType::Plus,
            '-' => TokenType::Minus,
            '*' => TokenType::Mul,
            '/' => TokenType::Div,
            '%' => TokenType::Mod,
            '&' => TokenType::And,
            '|' => TokenType::Or,
            '^' => TokenType::Xor,
            '!' => TokenType::Not,
            '(' => TokenType::LeftParen,
            ')' => TokenType::RightParen,
            '[' => TokenType::LeftBracket,
            ']' => TokenType::RightBracket,
            '{' => TokenType::LeftBrace,
            '}' => TokenType::RightBrace,
            ',' => TokenType::Comma,
            ':' => TokenType::Colon,
            '$' => TokenType::Dollar,
            '<' if next == '<' => TokenType::LeftShift,
            '>' if next == '>' => TokenType::RightShift,
            _ => TokenType::Unknown
        };

        this.index += if _type == TokenType::LeftShift || _type == TokenType::RightShift { 2 } else { 1 };
        this.Make(_type, start)
    }

    pub fn Next(&mut this) -> Token {
        loop {
            let character = this.CurrentChar();

            if character == ' ' || character == '\t' || character == '\r' {
                this.index += 1;
                continue;
            }

            if character == ';' {
                while this.CurrentChar() != '\n' && this.CurrentChar() != '\0' { this.index += 1; }
                continue;
            }

            let start = this.index;

            if character == '\0' {
                return this.Make(TokenType::EndOfFile, start);
            }

            if character == '\n' {
                this.index += 1;
                return this.Make(TokenType::NewLine, start);
            }

            if character == '"' || character == '\'' {
                let mut value = String();
                this.ScanQuoted(value, true);
                return this.Make(if character == '"' { TokenType::String } else { TokenType::Character }, start);
            }

            if this.IsDigit(character) {
                return this.LexNumber();
            }

            if this.IsAlpha(character) || (character as u8) > 0x7F {
                return this.LexIdentifier();
            }

            let token = this.LexSymbol();

            if token._type == TokenType::Unknown {
                Logger::Log("Invalid symbol '" + character.ToString() + "'.", token.span, LogSeverity::Error);
                continue;
            }

            return token;
        }
    }
}
