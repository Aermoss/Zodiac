#[include "std/io", "std/str", "std/vec", "std/file", "src/Disassembler/Disassembler.zir", "src/Common/Endian.zir",
    "src/Common/File.zir", "src/Common/Object.zir", "src/Common/Archive.zir", "src/Common/Binary.zir", "src/Common/Logger.zir" : *]

fn PrintVersion(executable: String) {
    WriteLine("Unversioned build of " + executable + ".");
    WriteLine("Copyright (c) 2026 Yusuf Rençber.");
    WriteLine("Licensed under the Apache License, Version 2.0.");
    WriteLine("See the LICENSE file for details.");
}

fn PrintUsage(executable: String) {
    WriteLine("OVERVIEW: Zodiac disassembler");
    WriteLine("USAGE: " + executable + " [options] <inputs...>");
    WriteLine("OPTIONS:");
    WriteLine("  -o <file>                Write output to <file> (default: stdout)");
    WriteLine("  --version                Display disassembler version");
    WriteLine("  -h, --help               Display this help message");
}

fn Main(args: &mut Vector<String>) -> i32 {
    let (_, executable) = SplitPath(args[0]);
    let mut logger = Logger(executable);

    if args.Length() < 2 {
        PrintUsage(executable);
        return 1;
    }

    let mut output: String;
    let mut inputs: Vector<String>;
    let mut i: usize = 1;

    while i < args.Length() {
        let arg = args[i];

        if arg == "--help" || arg == "-h" {
            PrintUsage(executable);
            return 0;
        } else if arg == "--version" {
            PrintVersion(executable);
            return 0;
        } else if arg == "-o" {
            i += 1;

            if i < args.Length() {
                output = args[i];
            } else {
                Logger::Log("Missing argument to '-o'.", LogSeverity::Error);
                return 1;
            }
        } else {
            if FileExists(arg) {
                inputs.PushBack(arg);
            } else {
                Logger::Log("Cannot find '" + arg + "'.", LogSeverity::Error);
                return 1;
            }
        } i += 1;
    }

    if inputs.Empty() {
        Logger::Log("No input files.", LogSeverity::Error);
        return 1;
    }

    let mut disassembler = Disassembler();

    for input in inputs {
        let (_, extension) = SplitExtension(input);

        if extension == ".a" {
            let mut file = File(input);

            if !file.Open(FileMode::ReadBinary) {
                Logger::Log("Failed to open file '" + input + "'.", LogSeverity::Error);
                return 1;
            }

            let magic = file.ReadWord();

            if magic == ARCHIVE_MAGIC {
                disassembler.objects += Archive::Read(file).objects;
            } else {
                Logger::Log("Invalid archive format '" + input + "'.", LogSeverity::Error);
                return 1;
            }
        } else if extension == ".o" {
            let mut file = File(input);

            if !file.Open(FileMode::ReadBinary) {
                Logger::Log("Failed to open file '" + input + "'.", LogSeverity::Error);
                return 1;
            }

            let magic = file.ReadWord();

            if magic == OBJECT_MAGIC {
                disassembler.objects.PushBack(Object::Read(file));
            } else {
                Logger::Log("Invalid object format '" + input + "'.", LogSeverity::Error);
                return 1;
            }
        } else if extension == ".bin" {
            let mut file = File(input);

            if !file.Open(FileMode::ReadBinary) {
                Logger::Log("Failed to open file '" + input + "'.", LogSeverity::Error);
                return 1;
            }

            let mut object = Object();
            object.sections.Resize(SECTION_COUNT);
            object.path = input;

            loop {
                let mut word: u32 = 0;
                if !file.ReadWords(&mut word, 1) { break; }
                object.sections[0].PushBack(ByteSwap32(word));
            }

            disassembler.objects.PushBack(object);
        } else if extension == ".hex" {
            let content = match _ReadFile(input) {
                Result<String, IOError>::Ok(content) => content,
                Result<String, IOError>::Err(error) => {
                    Logger::Log("Failed to read file '" + input + "': " + error.ToString() + ".", LogSeverity::Error);
                    return 1;
                }
            };

            let mut object = Object();
            object.sections.Resize(SECTION_COUNT);
            object.path = input;

            for line in content.Split('\n') {
                if line.Empty() { continue; }
                let word = line.Strip().ToInteger(16).Unwrap() as u32;
                object.sections[0].PushBack(word);
            }

            disassembler.objects.PushBack(object);
        } else if extension.Empty() {
            let mut file = File(input);

            if !file.Open(FileMode::ReadBinary) {
                Logger::Log("Failed to open file '" + input + "'.", LogSeverity::Error);
                return 1;
            }

            let magic = file.ReadWord();

            if magic != EXECUTABLE_MAGIC {
                Logger::Log("Invalid executable format '" + input + "'.", LogSeverity::Error);
                return 1;
            }

            let entry = file.ReadWord();
            let code_words = file.ReadWord();
            let relocation_count = file.ReadWord();

            let mut object = Object();
            object.sections.Resize(SECTION_COUNT);
            object.path = input;
            object.sections[0].Resize(code_words as usize);

            if code_words > 0 && !file.ReadWords(object.sections[0].Data(), code_words as usize) {
                Logger::Log("Invalid executable format '" + input + "'.", LogSeverity::Error);
                return 1;
            }

            let mut symbol = Symbol();
            symbol.name = "_entry";
            symbol.binding = BindingType::Global;
            symbol.section = SectionType::Text;
            symbol.offset = entry;
            object.symbols.PushBack(symbol);

            for _ in 0..relocation_count {
                let mut relocation = Relocation();
                relocation.section = SectionType::Text;
                relocation.offset = file.ReadWord();
                relocation._type = RelocationType::Absolute32;
                relocation.symbol = "_base";
                object.relocations.PushBack(relocation);
            }

            disassembler.objects.PushBack(object);
        } else {
            Logger::Log("Unsupported file extension '" + extension + "'.", LogSeverity::Error);
            return 1;
        }
    }

    let result = disassembler.Disassemble(output.Empty());

    if output.Empty() {
        WriteLine(result);
    } else {
        let mut file = File(output);

        if !file.Open(FileMode::Write) {
            Logger::Log("Failed to open file '" + output + "'.", LogSeverity::Error);
            return 1;
        }

        file.WriteBytes(result.Data() as *u8, result.Length());
    }

    0
}
