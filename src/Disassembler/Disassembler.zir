#[include "std/str", "std/vec", "src/Common/Object.zir", "src/Common/Logger.zir",
    "src/Common/Instruction.zir", "src/Common/Section.zir", "src/Common/Symbol.zir", "src/Common/Relocation.zir" : *]

class Disassembler {
    pub objects: Vector<Object>;

    fn GetRelocationSymbol(&this, object: &Object, section: SectionType, offset: u32) -> String {
        for relocation in object.relocations {
            if relocation.section == section && relocation.offset == offset {
                return relocation.symbol;
            }
        }

        "".ToString()
    }

    fn DisassembleRegister(&this, register: u32) -> String {
        "x" + String::FromInteger(register as u64)
    }

    fn DisassembleInstruction(&this, word: u32, offset: u32, section: SectionType, object: &Object) -> String {
        let opcode = (word >> OPCODE_SHIFT) as Opcode;
        let (reg0, reg1, reg2) = ((word >> REG0_SHIFT) & 0x1F, (word >> REG1_SHIFT) & 0x1F, (word >> REG2_SHIFT) & 0x1F);
        let (imm11, imm16, imm21, imm26) = (word & IMM11_MASK, word & IMM16_MASK, word & IMM21_MASK, word & IMM26_MASK);
        let simm11 = (((imm11 as i32) ^ (1 << 10)) - (1 << 10)) as i64;
        let simm16 = (((imm16 as i32) ^ (1 << 15)) - (1 << 15)) as i64;
        let simm21 = (((imm21 as i32) ^ (1 << 20)) - (1 << 20)) as i64;
        let simm26 = (((imm26 as i32) ^ (1 << 25)) - (1 << 25)) as i64;

        let mnemonic = match opcode {
            Opcode::NOP => "nop",
            Opcode::LB => "lb",
            Opcode::LBU => "lbu",
            Opcode::LH => "lh",
            Opcode::LHU => "lhu",
            Opcode::LW => "lw",
            Opcode::LUI => "lui",
            Opcode::AUIPC => "auipc",
            Opcode::SB => "sb",
            Opcode::SH => "sh",
            Opcode::SW => "sw",
            Opcode::B => "b",
            Opcode::BR => "br",
            Opcode::BL => "bl",
            Opcode::BLR => "blr",
            Opcode::BEQ => "beq",
            Opcode::BNE => "bne",
            Opcode::BLT => "blt",
            Opcode::BLTU => "bltu",
            Opcode::BGE => "bge",
            Opcode::BGEU => "bgeu",
            Opcode::SLT => "slt",
            Opcode::SLTU => "sltu",
            Opcode::SLTI => "slti",
            Opcode::SLTIU => "sltiu",
            Opcode::ADD => "add",
            Opcode::ADDI => "addi",
            Opcode::SUB => "sub",
            Opcode::SUBI => "subi",
            Opcode::MUL => "mul",
            Opcode::MULH => "mulh",
            Opcode::MULHSU => "mulhsu",
            Opcode::MULHU => "mulhu",
            Opcode::DIV => "div",
            Opcode::DIVU => "divu",
            Opcode::REM => "rem",
            Opcode::REMU => "remu",
            Opcode::AND => "and",
            Opcode::ANDI => "andi",
            Opcode::OR => "or",
            Opcode::ORI => "ori",
            Opcode::XOR => "xor",
            Opcode::XORI => "xori",
            Opcode::SLL => "sll",
            Opcode::SLLI => "slli",
            Opcode::SRL => "srl",
            Opcode::SRLI => "srli",
            Opcode::SRA => "sra",
            Opcode::SRAI => "srai",
            Opcode::HLT => "hlt"
        }.ToString();

        if opcode >= Opcode::LB && opcode <= Opcode::SW {
            if opcode == Opcode::LUI || opcode == Opcode::AUIPC {
                let relocation = this.GetRelocationSymbol(object, section, offset);
                if !relocation.Empty() { return mnemonic + " " + this.DisassembleRegister(reg0) + ", " + relocation; }
                mnemonic + " " + this.DisassembleRegister(reg0) + ", " + String::FromInteger(simm21)
            } else {
                mnemonic + " " + this.DisassembleRegister(reg0) + ", " + String::FromInteger(simm16) + "(" + this.DisassembleRegister(reg1) + ")"
            }
        } else if opcode == Opcode::B {
            let relocation = this.GetRelocationSymbol(object, section, offset);
            if !relocation.Empty() { return mnemonic + " " + relocation; }
            mnemonic + " " + String::FromInteger(simm26)
        } else if opcode == Opcode::BL {
            let relocation = this.GetRelocationSymbol(object, section, offset);
            if !relocation.Empty() { return mnemonic + " " + this.DisassembleRegister(reg0) + ", " + relocation; }
            mnemonic + " " + this.DisassembleRegister(reg0) + ", " + String::FromInteger(simm21)
        } else if opcode == Opcode::BR {
            mnemonic + " " + this.DisassembleRegister(reg0)
        } else if opcode == Opcode::BLR {
            mnemonic + " " + this.DisassembleRegister(reg0) + ", " + this.DisassembleRegister(reg1)
        } else if opcode >= Opcode::BEQ && opcode <= Opcode::BGEU {
            let relocation = this.GetRelocationSymbol(object, section, offset);
            if !relocation.Empty() { return mnemonic + " " + this.DisassembleRegister(reg0) + ", " + this.DisassembleRegister(reg1) + ", " + relocation; }
            mnemonic + " " + this.DisassembleRegister(reg0) + ", " + this.DisassembleRegister(reg1) + ", " + String::FromInteger(simm16)
        } else if opcode >= Opcode::SLT && opcode <= Opcode::SLTIU {
            if opcode == Opcode::SLT || opcode == Opcode::SLTU {
                mnemonic + " " + this.DisassembleRegister(reg0) + ", " + this.DisassembleRegister(reg1) + ", " + this.DisassembleRegister(reg2)
            } else {
                mnemonic + " " + this.DisassembleRegister(reg0) + ", " + this.DisassembleRegister(reg1) + ", " + String::FromInteger(simm16)
            }
        } else if opcode >= Opcode::ADD && opcode <= Opcode::SRAI {
            if (Opcode::ADD as u32 % 2 == opcode as u32 % 2) {
                mnemonic + " " + this.DisassembleRegister(reg0) + ", " + this.DisassembleRegister(reg1) + ", " + this.DisassembleRegister(reg2)
            } else {
                mnemonic + " " + this.DisassembleRegister(reg0) + ", " + this.DisassembleRegister(reg1) + ", " + String::FromInteger(simm16)
            }
        } else {
            mnemonic
        }
    }

    fn FormatHexWord(&this, word: u32) -> String {
        let mut hex = String::FromInteger(word as u64, 16);
        while hex.Length() < 8 { hex = "0" + hex; }

        hex.SubString(0, 2) + " " + hex.SubString(2, 2) + " "
            + hex.SubString(4, 2) + " " + hex.SubString(6, 2)
    }

    fn FormatHexAddress(&this, address: u32) -> String {
        let mut hex = String::FromInteger(address as u64, 16);
        while hex.Length() < 8 { hex = "0" + hex; }
        hex
    }

    fn FormatRelocation(&this, _type: RelocationType) -> String {
        match _type {
            RelocationType::AbsoluteUpper21 => "R_ABS_HI21",
            RelocationType::AbsoluteLower11 => "R_ABS_LO11",
            RelocationType::PcRelativeUpper21 => "R_PCREL_HI21",
            RelocationType::PcRelativeLower11 => "R_PCREL_LO11",
            RelocationType::Branch16 => "R_BR16",
            RelocationType::Branch21 => "R_BR21",
            RelocationType::Branch26 => "R_BR26",
            RelocationType::Absolute32 => "R_ABS32",
            _ => "R_UNKNOWN"
        }.ToString()
    }

    pub fn Disassemble(&mut this, format: bool) -> String {
        let mut result = String();

        for object in this.objects {
            if !object.path.Empty() {
                if format {
                    result += "\nDisassembly of object: " + object.path + '\n';
                } else {
                    result += "; Disassembly of object: " + object.path + '\n';
                }
            }

            for index in 0..object.sections.Length() {
                let section_type = index as SectionType;
                let section_name = if section_type == SectionType::Text { ".text" } else { ".data" };
                let section = object.sections[index];
                if section.Empty() { continue; }

                if format {
                    result += "Disassembly of section " + section_name.ToString() + ":\n";
                } else {
                    result += section_name.ToString() + '\n';
                }

                let mut offset: u32 = 0;

                for word in section {
                    for symbol in object.symbols {
                        if symbol.section == section_type && symbol.offset == offset {
                            if format {
                                result += '\n' + this.FormatHexAddress(offset) + " <" + symbol.name + ">:\n";
                            } else {
                                result += symbol.name + ":\n";
                            }
                        }
                    }

                    if format {
                        result += this.FormatHexAddress(offset) + ":   " + this.FormatHexWord(word);

                        if section_type == SectionType::Text {
                            result += "     " + this.DisassembleInstruction(word, offset, section_type, object) + '\n';

                            for relocation in object.relocations {
                                if relocation.section == section_type && relocation.offset == offset {
                                    result += "                        " + this.FormatHexAddress(offset) + ": " + this.FormatRelocation(relocation._type) + "   <" + relocation.symbol + ">\n";
                                }
                            }
                        } else {
                            result += '\n';
                        }
                    } else {
                        if section_type == SectionType::Text {
                            result += "    " + this.DisassembleInstruction(word, offset, section_type, object) + '\n';
                        } else {
                            result += "    .word " + String::FromInteger(word as i64) + '\n';
                        }
                    } offset += 4;
                } result += '\n';
            }
        }

        result
    }
}
