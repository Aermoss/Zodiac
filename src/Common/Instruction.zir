enum Opcode: u32 {
    NOP,
    LB, LBU, LH, LHU, LW, LUI, AUIPC, SB, SH, SW,
    B, BR, BL, BLR, BEQ, BNE, BLT, BLTU, BGE, BGEU,
    SLT, SLTU, SLTI, SLTIU,
    ADD, ADDI, SUB, SUBI,
    MUL, MULH, MULHSU, MULHU, DIV, DIVU, REM, REMU,
    AND, ANDI, OR, ORI, XOR, XORI,
    SLL, SLLI, SRL, SRLI, SRA, SRAI,
    CSRRW, CSRRS, CSRRC, CSRRWI, CSRRSI, CSRRCI,
    ECALL, EBREAK, ERET, WFI,
    HLT = 0x3F
}

enum CSR: u32 {
    STATUS, IENABLE, IPENDING, EPC, CAUSE, VECTOR, SCRATCH, BADADDR, PTBASE, ASID, TLBFLUSH,
    CYCLE = 16, INSTRET, TIME
}

enum TrapCause: u32 {
    InstructionFault = 0x00000001,
    IllegalInstruction = 0x00000002,
    Breakpoint = 0x00000003,
    LoadFault = 0x00000005,
    StoreFault = 0x00000007,
    SystemCall = 0x00000008,
    Timer = 0x80000000,
    Uart = 0x80000001
}

const STATUS_IE: u32 = 1;
const STATUS_PIE: u32 = 2;
const STATUS_PU: u32 = 4;

const FIRST_READ_ONLY_CSR: u32 = 16;
const LAST_READ_ONLY_CSR: u32 = 18;
const CSR_IMMEDIATE_MASK: u32 = 0x1F;

const WINDOW_START: u32 = 0xC0000000;
const PAGE_SHIFT: u32 = 12;
const PAGE_SIZE: u32 = 0x1000;
const PTBASE_VALID: u32 = 1;
const PTE_VALID: u32 = 1;
const PTE_WRITE: u32 = 2;
const PTE_EXECUTE: u32 = 4;

const OPCODE_SHIFT: u32 = 26;
const REG0_SHIFT: u32 = 21;
const REG1_SHIFT: u32 = 16;
const REG2_SHIFT: u32 = 11;

const IMM11_MASK: u32 = (1 << 11) - 1;
const IMM16_MASK: u32 = (1 << 16) - 1;
const IMM21_MASK: u32 = (1 << 21) - 1;
const IMM26_MASK: u32 = (1 << 26) - 1;

const IMM11_SMAX: u32 = (1 << 10) - 1;
const IMM16_SMAX: u32 = (1 << 15) - 1;
const IMM21_SMAX: u32 = (1 << 20) - 1;
const IMM26_SMAX: u32 = (1 << 25) - 1;

const IMM11_SMIN: u32 = 0 - (1 << 10);
const IMM16_SMIN: u32 = 0 - (1 << 15);
const IMM21_SMIN: u32 = 0 - (1 << 20);
const IMM26_SMIN: u32 = 0 - (1 << 25);
