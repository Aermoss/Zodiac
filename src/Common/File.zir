#[include "std/str", "std/file" : *]

class _File {
    pub path: String,
    file: *mut File = null;

    _File(&mut this, path: &String) {
        this.path = path;
    }

    ~_File(&mut this) {
        this.Close();
    }

    pub fn Open(&mut this, mode: FileMode) -> bool {
        if this.file == null { this.file = new File(); }
        this.file->Open(this.path, mode).IsOk()
    }

    pub fn Close(&mut this) {
        if this.file != null {
            this.file->Close();
            delete this.file;
            this.file = null;
        }
    }

    pub fn Seek(&this, offset: u32) -> bool {
        this.file->Seek(offset as isize, SeekOrigin::Start).IsOk()
    }

    pub fn ReadBytes(&this, pointer: *mut u8, count: usize) -> bool {
        this.file->ReadExact(pointer, count).IsOk()
    }

    pub fn ReadHalves(&this, pointer: *mut u16, count: usize) -> bool {
        if !this.ReadBytes(pointer as *mut u8, count * 2) { return false; }
        let bytes = pointer as *u8;
        let mut i: usize = 0;

        while i < count {
            let at = bytes + i * 2;
            pointer[i] = (at[0] as u16) | ((at[1] as u16) << 8);
            i += 1;
        }

        true
    }

    pub fn ReadWords(&this, pointer: *mut u32, count: usize) -> bool {
        if !this.ReadBytes(pointer as *mut u8, count * 4) { return false; }
        let bytes = pointer as *u8;
        let mut i: usize = 0;

        while i < count {
            let at = bytes + i * 4;
            pointer[i] = (at[0] as u32) | ((at[1] as u32) << 8) | ((at[2] as u32) << 16) | ((at[3] as u32) << 24);
            i += 1;
        }

        true
    }

    pub fn ReadByte(&this) -> u8 {
        this.file->ReadU8().UnwrapOr(0)
    }

    pub fn ReadHalf(&this) -> u16 {
        this.file->ReadU16().UnwrapOr(0)
    }

    pub fn ReadWord(&this) -> u32 {
        this.file->ReadU32().UnwrapOr(0)
    }

    pub fn WriteBytes(&this, pointer: *u8, count: usize) -> bool {
        this.file->Write(pointer, count).IsOk()
    }

    pub fn WriteHalves(&this, pointer: *u16, count: usize) -> bool {
        let mut i: usize = 0;

        while i < count {
            if this.file->WriteU16(pointer[i]).IsErr() { return false; }
            i += 1;
        }

        true
    }

    pub fn WriteWords(&this, pointer: *u32, count: usize) -> bool {
        let mut i: usize = 0;

        while i < count {
            if this.file->WriteU32(pointer[i]).IsErr() { return false; }
            i += 1;
        }

        true
    }

    pub fn WriteByte(&this, value: u8) -> bool {
        this.file->WriteU8(value).IsOk()
    }

    pub fn WriteHalf(&this, value: u16) -> bool {
        this.file->WriteU16(value).IsOk()
    }

    pub fn WriteWord(&this, value: u32) -> bool {
        this.file->WriteU32(value).IsOk()
    }

    pub fn ReadString(&this) -> String {
        let length = this.ReadWord() as usize;
        let buffer = new u8[length + 1];

        if !this.ReadBytes(buffer, length) {
            buffer[0] = 0;
        } else {
            buffer[length] = 0;
        }

        let string = String(buffer as *i8);
        delete[] buffer;
        string
    }

    pub fn WriteString(&this, value: &String) {
        this.WriteWord(value.Length() as u32);
        this.WriteBytes(value.Data() as *u8, value.Length());
    }
}
